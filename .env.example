# ============================================================
# CafeTrack - environment
#
# The default is the LOCAL database: PGlite (PostgreSQL compiled
# to WebAssembly) running inside the Node process, stored in
# ./.pglite and seeded on first use. No account, no network.
#
# Copy this file to .env.local and edit it.
# ============================================================

# ---------- local database (the default) ----------
# "local" selects the bundled PGlite database. Delete this line to
# use Supabase instead - see the bottom of this file.
CAFETRACK_DB=local

# Optional: where the local database lives. Defaults to ./.pglite.
# Handy for keeping a second database alongside the project.
# CAFETRACK_DB_DIR=.pglite

# ---------- session signing secret ----------
# REQUIRED in production: at least 32 characters. Anyone who knows
# this value can forge a session cookie, so never reuse the example
# below and never commit the real one.
#   openssl rand -hex 32
#   Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# ---------- first-run seed passwords ----------
# Used only when the local database is created for the first time.
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_PASSWORD=staff123

# ---------- test scripts ----------
# Where scripts/smoke-test.mjs and scripts/_edge-tests.mjs connect.
# BASE_URL=http://localhost:3100

# ---------- automatic daily backup (local mode only) ----------
# The server takes one on its own after this hour, if today's has not
# already been taken. Kept newest-3 under backups/cafetrack-auto-*.
# CAFETRACK_BACKUP_HOUR=3
# CAFETRACK_BACKUP_KEEP=3
# CAFETRACK_DISABLE_AUTO_BACKUP=1

# ---------- email notifications ----------
# You do NOT need these. An admin sets the sending account from
# Settings > Email — any Gmail or other SMTP server — and it takes
# effect without a restart. The app password is encrypted before it
# is stored and is never displayed again.
#
# These are only a FALLBACK, used when nothing is saved on the
# website. Anything saved there wins.
#
# Port 465 uses implicit TLS; anything else (587 is typical) upgrades
# with STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=cafetrack@example.com
# SMTP_PASS=your-app-password-or-app-specific-password
#
# TLS is required. A server offering none is refused rather than
# handed the password in cleartext; allow it for a local relay with:
# CAFETRACK_ALLOW_INSECURE=1
#
# Set this to 1 to stop the mail scheduler and dispatch entirely.
# CAFETRACK_DISABLE_EMAIL=1

# ---------- dev server (development only) ----------
# This machine's own network addresses are allowed automatically, so a device
# on the LAN can already load the page and its assets. Without that, a browser
# on the LAN loads the page but every stylesheet and script is refused, React
# never hydrates, and nothing is clickable.
#
# Only needed to add a hostname or an address that is not one of this
# machine's own, as bare hostnames with no scheme or port. These are ADDED to
# the automatic list, not substituted for it.
# DEV_ALLOWED_ORIGINS=cafetrack.local,192.168.1.50

# ============================================================
# Supabase - only if you delete CAFETRACK_DB above
# ============================================================
# 1. Run db/schema.sql in the Supabase SQL Editor.
# 2. Fill in the three values below from Project Settings > API.
# 3. npm run seed
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbJciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbJciOi...
