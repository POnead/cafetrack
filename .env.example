# ============================================================
# CafeTrack - environment
#
# The default is the LOCAL database: PGlite (PostgreSQL compiled
# to WebAssembly) running inside the Node process, stored in
# ./.pglite and seeded on first use. No account, no network.
#
# Copy this file to .env.local and edit it.
# ============================================================

# ---------- local database (the default) ----------
# "local" selects the bundled PGlite database. Delete this line to
# use Supabase instead - see the bottom of this file.
CAFETRACK_DB=local

# Optional: where the local database lives. Defaults to ./.pglite.
# Handy for keeping a second database alongside the project.
# CAFETRACK_DB_DIR=.pglite

# ---------- session signing secret ----------
# REQUIRED in production: at least 32 characters. Anyone who knows
# this value can forge a session cookie, so never reuse the example
# below and never commit the real one.
#   openssl rand -hex 32
#   Windows: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# ---------- first-run seed passwords ----------
# Used only when the local database is created for the first time.
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_PASSWORD=staff123

# ---------- test scripts ----------
# Where scripts/smoke-test.mjs and scripts/_edge-tests.mjs connect.
# BASE_URL=http://localhost:3000

# ---------- dev server (development only) ----------
# Extra hostnames allowed to reach `npm run dev`, as bare hostnames with no
# scheme or port. Without this, a device on the LAN loads the page but the
# HMR websocket is refused, React never hydrates, and nothing is clickable.
# Defaults to 192.168.1.9 when unset.
# DEV_ALLOWED_ORIGINS=192.168.1.9

# ============================================================
# Supabase - only if you delete CAFETRACK_DB above
# ============================================================
# 1. Run db/schema.sql in the Supabase SQL Editor.
# 2. Fill in the three values below from Project Settings > API.
# 3. npm run seed
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbJciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbJciOi...
