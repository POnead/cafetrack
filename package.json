{
  "name": "cafetrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:test": "node scripts/dev-test.mjs",
    "db:test:wipe": "node -e \"require('fs').rmSync(process.env.CAFETRACK_DB_DIR||'.pglite-test',{recursive:true,force:true});console.log('removed the test database')\"",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint src --ext .ts,.tsx",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "setup:face": "node scripts/setup-face-models.mjs",
    "db:reset": "node scripts/reset-local-db.mjs",
    "db:wipe": "node scripts/wipe-local-data.mjs",
    "db:schema": "node scripts/build-local-schema.mjs",
    "db:migrate": "node scripts/migrate-sql.mjs",
    "db:backup": "node scripts/backup-local-db.mjs",
    "db:restore": "node scripts/restore-local-db.mjs",
    "perf": "node scripts/perf-check.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:edge": "node scripts/_edge-tests.mjs",
    "test:pages": "node scripts/_pages.mjs",
    "test:journeys": "node scripts/_journeys.mjs",
    "test:ui": "node scripts/_ui.mjs",
    "test:tour": "node scripts/_usertour.mjs",
    "test:face": "node scripts/_ts-node.mjs scripts/_face-math.mjs",
    "test:face-image": "node scripts/_ts-node.mjs scripts/_face-image.mjs",
    "test:face-diagnostics": "node scripts/_ts-node.mjs scripts/_face-diagnostics.mjs",
    "test:id-name": "node scripts/_ts-node.mjs scripts/_id-name-tests.mjs",
    "test:ocr": "node scripts/_ts-node.mjs scripts/_ocr-tests.mjs",
    "test:id-forgery": "node scripts/_ts-node.mjs scripts/_id-forgery-tests.mjs",
    "test:id": "node scripts/_id-verification-tests.mjs",
    "test:camera": "node scripts/_camera-tests.mjs",
    "test:email": "node scripts/_email-tests.mjs",
    "test:ocr-live": "node scripts/_ts-node.mjs scripts/_ocr-live.mjs",
    "test:id-lookup": "node scripts/_ts-node.mjs scripts/_id-lookup-tests.mjs",
    "test:id-login": "node scripts/_id-login-tests.mjs",
    "test:step2-ticket": "node scripts/_ts-node.mjs scripts/_step2-ticket-tests.mjs",
    "test:staff-confirm": "node scripts/_staff-confirm-tests.mjs",
    "test:ocr-philsys": "node scripts/_ts-node.mjs scripts/_ocr-philsys-tests.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:all": "npm run test:face && npm run test:face-image && npm run test:face-diagnostics && npm run test:id-name && npm run test:ocr && npm run test:ocr-philsys && npm run test:id-forgery && npm run test:id-lookup && npm run test:step2-ticket && npm run test:id && npm run test:camera && npm run test:email && npm run test:edge && npm run test:pages && npm run test:journeys && npm run test:ui && npm run test:tour && npm run test:smoke && npm run perf"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.45.4",
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "jose": "^5.9.6",
    "jsbarcode": "^3.12.3",
    "next": "16.3.6",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.24",
    "playwright-core": "^1.63.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
